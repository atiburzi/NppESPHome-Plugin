      <module name="TFORMSELECTION" type="form">
        <items>
          <item name="FormSelection" type="TFormSelection">
            <properties>
              <property name="Caption">
                <value>Project Selection</value>
                <translations>
                  <translation language="en">Project Selection</translation>
                  <translation language="es" status="proposed">Selección de proyectos</translation>
                  <translation language="it" status="proposed">Selezione dei progetti</translation>
                </translations>
              </property>
              <property name="Font.Name" status="skip">
                <value>Segoe UI</value>
              </property>
            </properties>
          </item>
          <item name="FormSelection.ButtonClose" type="TButton">
            <properties>
              <property name="Caption">
                <value>Close</value>
                <translations>
                  <translation language="en">Close</translation>
                  <translation language="es" status="proposed">Cerrar</translation>
                  <translation language="it" status="proposed">Chiudi</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="FormSelection.FileOpenDialogProject" type="TFileOpenDialog">
            <properties>
              <property name="DefaultExtension" status="skip">
                <value>.yaml</value>
              </property>
            </properties>
          </item>
          <item name="FormSelection.FileOpenDialogProject.FileTypes[0]" type="TFileOpenDialog">
            <properties>
              <property name="DisplayName">
                <value>File</value>
                <translations>
                  <translation language="en">File</translation>
                  <translation language="es" status="proposed">Archivo</translation>
                  <translation language="it" status="proposed">File</translation>
                </translations>
              </property>
              <property name="FileMask" status="skip">
                <value>*.yaml</value>
              </property>
            </properties>
          </item>
          <item name="FormSelection.FileOpenDialogProject.FileTypes[1]" type="TFileOpenDialog">
            <properties>
              <property name="DisplayName">
                <value>File</value>
                <translations>
                  <translation language="en">File</translation>
                  <translation language="es" status="proposed">Archivo</translation>
                  <translation language="it" status="proposed">File</translation>
                </translations>
              </property>
              <property name="FileMask" status="skip">
                <value>*.yml</value>
              </property>
            </properties>
          </item>
          <item name="FormSelection.GroupBoxCurrentProject" type="TGroupBox">
            <properties>
              <property name="Caption">
                <value>Current Project</value>
                <translations>
                  <translation language="en">Current Project</translation>
                  <translation language="es" status="proposed">Proyecto actual</translation>
                  <translation language="it" status="proposed">Progetto in corso</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="FormSelection.GroupBoxCurrentProject.ButtonAddProject" type="TButton">
            <properties>
              <property name="Caption">
                <value>&amp;Add Project</value>
                <translations>
                  <translation language="en">&amp;Add Project</translation>
                  <translation language="es" status="proposed">&amp;Añadir proyecto</translation>
                  <translation language="it" status="proposed">&amp;Aggiungi progetto</translation>
                </translations>
              </property>
              <property name="Hint">
                <value>Add a new project to the known list of projects, selecting an existing YAML ESPHome project file</value>
                <translations>
                  <translation language="en">Add a new project to the known list of projects, selecting an existing YAML ESPHome project file</translation>
                  <translation language="es" status="proposed">Añadir un nuevo proyecto a la lista de proyectos conocidos, seleccionando un archivo de proyecto YAML de ESPHome ya existente</translation>
                  <translation language="it" status="proposed">Aggiungi un nuovo progetto all'elenco dei progetti noti, selezionando un file di progetto ESPHome in formato YAML già esistente</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="FormSelection.GroupBoxCurrentProject.ButtonRemoveProject" type="TButton">
            <properties>
              <property name="Caption">
                <value>&amp;Remove Project</value>
                <translations>
                  <translation language="en">&amp;Remove Project</translation>
                  <translation language="es" status="proposed">&amp;Eliminar proyecto</translation>
                  <translation language="it" status="proposed">&amp;Rimuovi progetto</translation>
                </translations>
              </property>
              <property name="Hint">
                <value>Remove the current selected project from the list of the known ones</value>
                <translations>
                  <translation language="en">Remove the current selected project from the list of the known ones</translation>
                  <translation language="es" status="proposed">Eliminar el proyecto seleccionado actualmente de la lista de proyectos conocidos</translation>
                  <translation language="it" status="proposed">Rimuovi il progetto attualmente selezionato dall'elenco dei progetti noti</translation>
                </translations>
              </property>
            </properties>
          </item>
        </items>
      </module>
