          <item name="ESPHomePlugin_rsNoProjectSelected">
            <properties>
              <property>
                <value>No ESPHome project is currently selected.</value>
                <translations>
                  <translation language="en">No ESPHome project is currently selected.</translation>
                  <translation language="it">Al momento non è selezionato alcun progetto ESPHome.</translation>
