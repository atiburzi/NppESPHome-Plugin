                </translations>
              </property>
            </properties>
          </item>
          <item name="ESPHomePlugin_rsNoProjectSelected2">
            <properties>
              <property>
                <value>To use this command, please select the current project and try again.&amp;#13;&amp;#13;&amp;#10;You can select it through the menu command:&amp;#13;&amp;#10;"Plugins" -&gt; "NppESPHome" -&gt; "Select Project..."</value>
                <translations>
                  <translation language="en">To use this command, please select the current project and try again.&amp;#13;&amp;#13;&amp;#10;You can select it through the menu command:&amp;#13;&amp;#10;"Plugins" -&gt; "NppESPHome" -&gt; "Select Project..."</translation>
                  <translation language="it">Per usare questo comando, per favore selezona il progetto corrente e prova di nuovo. È possibile selezionarlo tramite il comando del menu:&amp;#13;&amp;#10;"Plugins" -&gt; "NppESPHome" -&gt; "Seleziona Progetto..."&amp;#13;&amp;#10;&amp;#13;&amp;#10;</translation>
                  <translation language="es" status="proposed">Para usar este comando, selecciona el proyecto actual e inténtalo de nuevo. Puedes seleccionarlo mediante el comando de menú:&amp;#13;&amp;#10;"Plugins" -&gt; "NppESPHome" -&gt; "Select Project..."</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="ESPHomePlugin_rsProjectAddFileOpenTitle">
            <properties>
