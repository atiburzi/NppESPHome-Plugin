          <item name="ESPHomeShared_rsConfirmExecuteCleanAll">
            <properties>
              <property>
                <value>Are you sure you want to run "esphome clean-all" command?</value>
                <translations>
                  <translation language="en">Are you sure you want to run "esphome clean-all" command?</translation>
                  <translation language="it">Sei sicuro di voler eseguire il comando "esphome clean-all"?</translation>
                  <translation language="es" status="proposed">¿Estás seguro de que quieres ejecutar el comando «esphome clean-all»?</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="ESPHomeShared_rsConfirmExecuteCleanAll2">
            <properties>
              <property flags="A">
                <value>You are about to run "esphome clean-all" for project "%s".&amp;#13;&amp;#10;&amp;#13;&amp;#10;This will remove all ESPHome build files, PlatformIO platforms and packages, and the PlatformIO core directory related to the selected project or working folder.&amp;#13;&amp;#10;&amp;#13;&amp;#10;This is useful for a full rebuild, but the next compilation may take a long time.&amp;#13;&amp;#10;&amp;#13;&amp;#10;Do you want to continue?</value>
                <translations>
                  <translation language="en">You are about to run "esphome clean-all" for project "%s".&amp;#13;&amp;#10;&amp;#13;&amp;#10;This will remove all ESPHome build files, PlatformIO platforms and packages, and the PlatformIO core directory related to the selected project or working folder.&amp;#13;&amp;#10;&amp;#13;&amp;#10;This is useful for a full rebuild, but the next compilation may take a long time.&amp;#13;&amp;#10;&amp;#13;&amp;#10;Do you want to continue?</translation>
                  <translation language="it">Stai per eseguire “esphome clean-all” per il progetto “%s”.&amp;#13;&amp;#10;&amp;#13;&amp;#10;Questa operazione rimuoverà tutti i file di build di ESPHome, le piattaforme e i pacchetti PlatformIO, nonché la directory core di PlatformIO relativi al progetto selezionato o alla cartella di lavoro.&amp;#13;&amp;#10;&amp;#13;&amp;#10;È utile per eseguire una ricompilazione completa, ma la prossima compilazione potrebbe richiedere molto tempo.&amp;#13;&amp;#10;&amp;#13;&amp;#10;Vuoi continuare?</translation>
                  <translation language="es" status="proposed">You are about to run "esphome clean-all" for project "%s".&amp;#13;&amp;#10;&amp;#13;&amp;#10;Estás a punto de ejecutar "esphome clean-all" para el proyecto "%s".&amp;#13;&amp;#10;&amp;#13;&amp;#10;Esto eliminará todos los archivos de compilación de ESPHome, las plataformas y paquetes de PlatformIO, y el directorio principal de PlatformIO relacionados con el proyecto o la carpeta de trabajo seleccionados.&amp;#13;&amp;#10;&amp;#13;&amp;#10;Esto es útil para una reconstrucción completa, pero la siguiente compilación puede tardar mucho tiempo.&amp;#13;&amp;#10;&amp;#13;&amp;#10;¿Quieres continuar?</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="ESPHomeShared_rsConfirmOverwriteTemplates">
            <properties>
              <property>
                <value>You are going to overwrite your "NppESPHome.xml" templates file with the one available on GitHub.</value>
                <translations>
                  <translation language="en">You are going to overwrite your "NppESPHome.xml" templates file with the one available on GitHub.</translation>
                  <translation language="it">Sostituirai il tuo file di modelli "NppESPHome.xml" con quello disponibile su GitHub.</translation>
                  <translation language="es" status="proposed">Vas a sobrescribir tu archivo de plantillas «NppESPHome.xml» con el que está disponible en GitHub.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="ESPHomeShared_rsConfirmOverwriteTemplates2">
            <properties>
              <property>
                <value>Any modification done on the local XML will be lost.</value>
                <translations>
                  <translation language="en">Any modification done on the local XML will be lost.</translation>
                  <translation language="it">Qualsiasi modifica apportata al file XML locale andrà persa.</translation>
                  <translation language="es" status="proposed">Cualquier modificación que se realice en el archivo XML local se perderá.</translation>
                </translations>
              </property>
