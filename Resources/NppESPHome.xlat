              <property>
                <value>Are you sure you want to continue?</value>
                <translations>
                  <translation language="en">Are you sure you want to continue?</translation>
                  <translation language="it">Sei sicuro di voler continuare?</translation>
                  <translation language="es" status="proposed">¿Estás seguro de que quieres continuar?</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="ESPHomeShared_rsConfirmOverwriteTemplates4">
            <properties>
              <property>
                <value>I am really sure and I want to overwrite my local template file.</value>
