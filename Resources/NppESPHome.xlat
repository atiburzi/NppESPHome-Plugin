                  <translation language="es" status="proposed">&amp;Restablecer barra de herramientas</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="FormToolbar.LabelInfo" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Use checkbox to enable/disable the button.&amp;#13;&amp;#10;Use mouse Drag&amp;&amp;Drop or Ctrl+Up/Down to exchange the buttons order.</value>
                <translations>
                  <translation language="en">Use checkbox to enable/disable the button.&amp;#13;&amp;#10;Use mouse Drag&amp;&amp;Drop or Ctrl+Up/Down to exchange the buttons order.</translation>
                  <translation language="it" status="proposed">Usa la casella di controllo per abilitare/disabilitare il pulsante.&amp;#13;&amp;#10;Usa il trascinamento con il mouse oppure Ctrl+Su/Giù per modificare l’ordine dei pulsanti.</translation>
                  <translation language="es" status="proposed">Usa la casilla de verificación para activar/desactivar el botón.&amp;#13;&amp;#10;Usa arrastrar y soltar con el ratón o Ctrl+Arriba/Abajo para cambiar el orden de los botones.</translation>
                </translations>
              </property>
            </properties>
          </item>
